# SATCORP   engagement brief delivery
#
# Copy to .env.local and fill in whichever transports you want. The same values
# have to be set in the hosting platform's environment, not just here.
#
# On a box with a real disk, every submission is also written to .intake/<ref>.json
# and that file is the record. On a serverless platform the filesystem is
# ephemeral, so AT LEAST ONE transport below must be configured   with none set,
# the form refuses the submission rather than sealing it over a message that
# went nowhere.

# --- A formatted brief in the ops channel. Primary transport in production. ---
DISCORD_WEBHOOK_URL=

# --- Partnership approaches (/partner) deliver to their own channel. ---
# Falls back to DISCORD_WEBHOOK_URL when unset, so approaches are never
# silently dropped on a fresh deployment.
PARTNER_WEBHOOK_URL=

# --- Email, via Resend. Both are required for email to send. ---
RESEND_API_KEY=
INTAKE_TO_EMAIL=
# Partnership approaches by email. Falls back to INTAKE_TO_EMAIL when unset.
PARTNER_TO_EMAIL=
# Must be a domain verified with Resend.
INTAKE_FROM_EMAIL=brief@satcorp.io

# --- Optional: override where records are written. ---
# Engagement briefs, default .intake/
INTAKE_DIR=
# Partnership approaches, default .partner/
PARTNER_DIR=
